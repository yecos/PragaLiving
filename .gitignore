# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# SECRETS — never commit
# ============================================
# .env* matches .env, .env.local, .env.production, .env.example, etc.
# Note: we DO commit .env.example (template with placeholders only) so it's
# explicitly un-ignored below.
.env
.env.local
.env.production
.env.development
.env.test
!.env.example

# ============================================
# DATABASES — never commit (may contain PII or hashed passwords)
# ============================================
db/*.db
db/*.db-journal
*.sqlite
*.sqlite3

# ============================================
# LARGE BINARIES — should live in Supabase Storage / S3, not git
# ============================================
upload/
download/
*.dwg
*.glb
*.gltf
*.dae
*.obj
*.fbx
# Allow specific small assets that are intentionally tracked:
!public/models/praga-building.glb
!src/fonts/*.woff2

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log

# Skills directory
/skills/

# Agent context (internal dev prompts — not for public repo)
/agent-ctx/
