# ===========================================
# PRAGA Living — Environment Variables Example
# ===========================================
# Copy this file to .env.local (local dev) or set in Vercel Project Settings.
# NEVER commit the real .env file to git.

# ---- Database (Neon Postgres) ----
# Two URLs from your Neon project dashboard:
#   https://console.neon.tech/app/projects → select project → "Connection Details"
#
# DATABASE_URL = pooled connection (with -pooler- in hostname + ?pgbouncer=true)
#   Used by the running app (serverless-friendly, many short-lived connections).
#
# DIRECT_DATABASE_URL = direct connection (no -pooler-, no ?pgbouncer=true)
#   Used by Prisma migrations (needs DDL support, pgbouncer blocks it).
#
# Both are required for the app to work correctly.
DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-pooler-REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Admin credentials ----
ADMIN_USERNAME="admin"

# BCRYPT HASH of the admin password. Generate with:
#   bun run scripts/hash-password.ts "your-password"
# NEVER store the plaintext password here.
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_GENERATED_BCRYPT_HASH"

# ---- NextAuth ----
# Secret used to sign JWTs. Generate with: openssl rand -base64 32
# MUST be set in production. If empty, the app refuses to start.
NEXTAUTH_SECRET=""

# URL of the deployed site (used for email links, CORS, absolute URLs)
NEXT_PUBLIC_URL="https://pragaliving.com"

# ---- Email (Resend) ----
# Get from https://resend.com/api-keys
RESEND_API_KEY=""

# Sales/notifications email address (where new-lead alerts are sent)
SALES_EMAIL="ventas@pragaliving.com"

# ---- Optional: Upstash Redis (rate limiting in serverless) ----
# If not set, falls back to in-memory rate limiting (NOT reliable across instances).
# Recommended for production. Free tier at https://upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Optional: Google Analytics ----
NEXT_PUBLIC_GA_ID=""
