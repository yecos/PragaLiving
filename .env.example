# ===========================================
# PRAGA Living — Environment Variables Example
# ===========================================
# Copy this file to .env.local (local dev) or set in Vercel Project Settings.
# NEVER commit the real .env file to git.

# ---- Database (local dev) ----
# SQLite path — only used in local dev. Production uses Supabase.
DATABASE_URL="file:./dev.db"

# ---- Admin credentials ----
# Username for the env-fallback admin (used when Supabase/Prisma are unavailable)
ADMIN_USERNAME="admin"

# BCRYPT HASH of the admin password. Generate with:
#   bun run scripts/hash-password.ts
# or:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# NEVER store the plaintext password here.
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_GENERATED_BCRYPT_HASH"

# ---- NextAuth ----
# Secret used to sign JWTs. Generate with:
#   openssl rand -base64 32
# MUST be set in production. If empty, the app refuses to start.
NEXTAUTH_SECRET=""

# URL of the deployed site (used for email links, CORS, absolute URLs)
NEXT_PUBLIC_URL="https://pragaliving.com"

# ---- Supabase ----
# Public anon key (safe to expose in browser — protected by RLS)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key (SERVER ONLY — bypasses RLS, can do anything)
# NEVER expose this in client-side code. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Email (Resend) ----
# Get from https://resend.com/api-keys
RESEND_API_KEY=""

# Sales/notifications email address (where new-lead alerts are sent)
SALES_EMAIL="ventas@pragaliving.com"

# ---- Optional: Upstash Redis (rate limiting in serverless) ----
# If not set, falls back to in-memory rate limiting (NOT reliable across instances).
# Recommended for production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Optional: Google Analytics ----
NEXT_PUBLIC_GA_ID=""
